   "type": "integer"
  },
  "sections": {
   "items": {
    "$ref": "#/$defs/LibrarySection"
   },
   "title": "Sections",
   "type": "array"
  }
 },
 "required": [
  "schema_version",
  "sections"
 ],
 "title": "Library",
 "type": "object"
}
