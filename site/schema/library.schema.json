{
 "$defs": {
  "LibraryDoc": {
   "additionalProperties": false,
   "properties": {
    "path": {
     "title": "Path",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    },
    "section": {
     "title": "Section",
     "type": "string"
    },
    "url": {
     "title": "Url",
     "type": "string"
    },
    "date": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
