   "properties": {
    "kind": {
     "title": "Kind",
     "type": "string"
    },
    "points": {
     "items": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "title": "Points",
     "type": "array"
    }
   },
   "required": [
    "kind",
    "points"
   ],
   "title": "Glyph",
   "type": "object"
  },
  "Run": {
   "additionalProperties": false,
   "properties": {
    "scenario": {
     "title": "Scenario",
     "type": "string"
    },
    "setup": {
     "title": "Setup",
     "type": "string"
    },
    "firmware": {
     "title": "Firmware",
     "type": "string"
    },
    "flown": {
     "title": "Flown",
     "type": "boolean"
    },
    "passed": {
     "title": "Passed",
     "type": "boolean"
    },
    "file": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "File"
    },
    "glyph": {
     "anyOf": [
      {
       "$ref": "#/$defs/Glyph"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "scenario",
    "setup",
    "firmware",
    "flown",
    "passed"
   ],
   "title": "Run",
   "type": "object"
  },
  "ScenarioAbout": {
   "additionalProperties": false,
   "properties": {
    "name": {
     "title": "Name",
     "type": "string"
    },
    "step": {
     "title": "Step",
     "type": "integer"
    },
    "what": {
     "title": "What",
     "type": "string"
    }
   },
   "required": [
    "name",
    "step",
    "what"
   ],
   "title": "ScenarioAbout",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "description": "flights.json: every run of both firmwares, for the matrices and the playback pages.",
 "properties": {
  "schema_version": {
   "title": "Schema Version",
   "type": "integer"
  },
  "scenarios": {
