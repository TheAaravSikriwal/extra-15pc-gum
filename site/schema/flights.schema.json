    "type": "string"
   },
   "title": "Scenarios",
   "type": "array"
  },
  "about": {
   "items": {
    "$ref": "#/$defs/ScenarioAbout"
   },
   "title": "About",
   "type": "array"
  },
  "setups": {
   "items": {
    "type": "string"
   },
   "title": "Setups",
   "type": "array"
  },
  "runs": {
   "items": {
    "$ref": "#/$defs/Run"
   },
   "title": "Runs",
   "type": "array"
  }
 },
 "required": [
  "schema_version",
  "scenarios",
  "about",
  "setups",
  "runs"
 ],
